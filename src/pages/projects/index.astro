---
// src/pages/projects/index.astro
import BaseLayout from '../../layouts/BaseLayout.astro';
import { getLocalizedContent } from '../../utils/content';

// 🆕 Получаем только английские проекты
const allProjects = await getLocalizedContent('projects', 'en');

// 🆕 Функция для получения чистого slug
function getSlugFromId(id: string) {
  return id.replace(/^(en|ru)\//, '').replace(/\.md$/, '');
}

// Группируем статьи по проектам
const projectsByName: Record<string, any[]> = {};
for (const post of allProjects) {
  const projectName = post.data.projectName;
  if (!projectsByName[projectName]) {
    projectsByName[projectName] = [];
  }
  projectsByName[projectName].push(post);
}
---

<BaseLayout title="Projects — My Dev Portfolio" lang="en">
  <div style="max-width: 800px; margin: 0 auto;">
    <h1 style="font-size: 2.5rem; margin-bottom: 0.5rem;">Projects</h1>
    <p style="color: #a1a1aa; margin-bottom: 2rem;">
      My personal projects and experiments
    </p>

    {Object.entries(projectsByName).map(([projectName, posts]) => {
      // Находим главный пост (index.md) или берем первый
      const mainPost = posts.find(p => {
        const slug = getSlugFromId(p.id);
        return slug === 'index';
      }) || posts[0];
      
      const techStack = mainPost?.data.techStack || [];
      const imageUrl = mainPost?.data.image?.url || mainPost?.data.image || null;
      
      // Создаем slug для проекта (из названия)
      const projectSlug = projectName.toLowerCase().replace(/\s+/g, '-');
      
      return (
        <div style="
          margin-bottom: 2rem;
          padding: 1.5rem;
          background-color: #111;
          border-radius: 16px;
          border: 1px solid #27272a;
          overflow: auto;
        ">
          {imageUrl && (
            <img 
              src={imageUrl} 
              alt={projectName}
              style="
                float: left;
                margin-right: 1rem;
                margin-bottom: 0.5rem;
                width: 120px;
                height: 120px;
                object-fit: cover;
                border-radius: 8px;
              "
            />
          )}
          
          <h2 style="margin-top: 0; margin-bottom: 0.5rem;">
            <a href={`/projects/${projectSlug}`} 
               style="color: inherit; text-decoration: none;">
              {projectName}
            </a>
          </h2>
          
          {techStack.length > 0 && (
            <div style="display: flex; flex-wrap: wrap; gap: 0.5rem; margin-bottom: 1rem;">
              {techStack.map(tech => (
                <span style="
                  font-size: 0.7rem;
                  padding: 0.2rem 0.6rem;
                  background-color: #1a1a1a;
                  border-radius: 9999px;
                  color: #c084fc;
                ">{tech}</span>
              ))}
            </div>
          )}
          
          <p style="color: #a1a1aa; margin-bottom: 1rem;">
            {mainPost?.data.description || "About this project"}
          </p>
          
          <div style="display: flex; gap: 1rem; flex-wrap: wrap;">
            {posts.map(post => {
              const slug = getSlugFromId(post.id);
              // Пропускаем index.md, так как это главная страница проекта
              if (slug === 'index') return null;
              return (
                <a href={`/projects/${projectSlug}/${slug}`} style="font-size: 0.875rem; color: #6366f1;">
                  📄 {post.data.title}
                </a>
              );
            })}
          </div>
        </div>
      );
    })}
  </div>
</BaseLayout>