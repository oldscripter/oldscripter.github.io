---
// src/pages/posts/[...slug].astro
import { getCollection, render } from 'astro:content';
import { getRelatedContent } from '../../utils/content';
import BlogPostLayout from '../../layouts/BlogPostLayout.astro';

export async function getStaticPaths() {
  const posts = await getCollection('posts');
  
  // ✅ Фильтруем АНГЛИЙСКИЕ посты по ID (начинаются с 'en/')
  const enPosts = posts.filter(post => post.id.startsWith('en/'));
  
  return enPosts.map(post => {
    // ✅ Правильно извлекаем slug: убираем 'en/' и '.md'
    const slug = post.id.replace(/^en\//, '').replace(/\.md$/, '');
    
    return {
      params: { slug: slug },
      props: { post },
    };
  });
}

const { post } = Astro.props;
const { Content } = await render(post);
const contentLength = post.body?.length || 0;

const slug = post.id.replace(/^en\//, '').replace(/\.md$/, '');
const ruPost = await getRelatedContent('posts', post, 'ru');
---

<BlogPostLayout frontmatter={post.data} contentLength={contentLength} lang="en">
  <article>
    <Content />
  </article>
  
</BlogPostLayout>