---
// src/pages/ru/cpp/[...slug].astro
import { getCollection, render } from 'astro:content';
import { getRelatedContent } from '../../../utils/content';
import BlogPostLayout from '../../../layouts/BlogPostLayout.astro';

export async function getStaticPaths() {
  const lessons = await getCollection('cpp-lessons');
  
  // ✅ Фильтруем только русские уроки
  const ruLessons = lessons.filter(lesson => lesson.id.startsWith('ru/'));
  
  return ruLessons.map(lesson => {
    // ✅ Правильно извлекаем slug
    const slug = lesson.id.replace(/^ru\//, '').replace(/\.md$/, '');
    
    return {
      params: { slug: slug },
      props: { lesson },
    };
  });
}

const { lesson } = Astro.props;
const { Content } = await render(lesson);
const contentLength = lesson.body?.length || 0;

// Получаем slug для ссылок
const slug = lesson.id.replace(/^ru\//, '').replace(/\.md$/, '');
// Находим английскую версию
const enLesson = await getRelatedContent('cpp-lessons', lesson, 'en');
---

<BlogPostLayout frontmatter={lesson.data} contentLength={contentLength} lang="ru">
  <article>
    <Content />
  </article>
  
  {enLesson && (
    <div style="margin-top: 2rem; padding: 1rem; background: #1a1a1a; border-radius: 8px; text-align: center;">
      <p style="color: #71717a; font-size: 0.9rem;">
        📖 Читать этот урок на 
        <a href={`/cpp/${slug}`} style="color: #6366f1; font-weight: 600;">
          Английском
        </a>
      </p>
    </div>
  )}
</BlogPostLayout>