---
// src/pages/ru/projects/index.astro
import BaseLayout from '../../../layouts/BaseLayout.astro';
import { getLocalizedContent } from '../../../utils/content';

// 🆕 Получаем только русские проекты
const allProjects = await getLocalizedContent('projects', 'ru');

// 🆕 Функция для получения чистого slug
function getSlugFromId(id: string) {
  return id.replace(/^(en|ru)\//, '').replace(/\.md$/, '');
}

// Группируем статьи по проектам
const projectsByName: Record<string, any[]> = {};
for (const post of allProjects) {
  const projectName = post.data.projectName;
  if (!projectsByName[projectName]) {
    projectsByName[projectName] = [];
  }
  projectsByName[projectName].push(post);
}
---

<BaseLayout title="Проекты — Моё портфолио" lang="ru">
  <div style="max-width: 800px; margin: 0 auto;">
    <h1 style="font-size: 2.5rem; margin-bottom: 0.5rem;">Проекты</h1>
    <p style="color: #a1a1aa; margin-bottom: 2rem;">
      Мои личные проекты и эксперименты
    </p>

    {Object.entries(projectsByName).map(([projectName, posts]) => {
      const mainPost = posts.find(p => {
        const slug = getSlugFromId(p.id);
        return slug === 'index';
      }) || posts[0];
      
      const techStack = mainPost?.data.techStack || [];
      const imageUrl = mainPost?.data.image?.url || mainPost?.data.image || null;
      const projectSlug = projectName.toLowerCase().replace(/\s+/g, '-');
      
      return (
        <div style="
          margin-bottom: 1rem;
          padding: 1.5rem;
          background-color: #111;
          border-radius: 16px;
          border: 1px solid #27272a;
          overflow: auto;
        ">
          {imageUrl && (
            <img 
              src={imageUrl} 
              alt={projectName}
              style="
                float: left;
                margin-right: 1rem;
                margin-bottom: 0.5rem;
                width: 120px;
                height: 120px;
                object-fit: cover;
                border-radius: 8px;
              "
            />
          )}
          
          <div>
            <h3>
              <a href={`/ru/projects/${projectSlug}`} 
                style="color: inherit; text-decoration: none;">
                {projectName}
              </a>
            </h3>
            
            {techStack.length > 0 && (
              <div style="display: flex; flex-wrap: wrap; gap: 0.5rem; margin-bottom: 1rem;">
                {techStack.map(tech => (
                  <span style="
                    font-size: 0.7rem;
                    padding: 0.2rem 0.6rem;
                    background-color: #1a1a1a;
                    border-radius: 9999px;
                    color: #c084fc;
                  ">{tech}</span>
                ))}
              </div>
            )}
            
            <p style="color: #a1a1aa; margin-bottom: 1rem;">
              {mainPost?.data.description || "О проекте"}
            </p>
          </div>
        </div>
      );
    })}
  </div>
</BaseLayout>