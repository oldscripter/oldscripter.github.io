---
// src/pages/ru/about.astro
import BaseLayout from '../../layouts/BaseLayout.astro';
---

<BaseLayout title="Обо мне — Разработчик игр" lang="ru">
  <div style="max-width: 700px; margin: 2rem auto;">
    
    <!-- Фото + имя -->
    <div style="text-align: center; margin-bottom: 2rem;">
      <img 
        src="/images/photo.jpg" 
        alt="Stanislav Talanov — Разработчик игр"
        style="
          width: 160px;
          height: 160px;
          border-radius: 50%;
          object-fit: cover;
          border: 3px solid #6366f1;
          margin-bottom: 1rem;
        "
      />
      <h1 style="font-size: 2rem; margin-bottom: 0.25rem;">Станислав Таланов</h1>
      <p style="color: #a1a1aa; font-size: 1rem;">Старший C++ разработчик | Unreal | Unity</p>
    </div>

    <!-- Краткое введение -->
    <p>Привет! Я разработчик с более чем 12-летним опытом в индустрии разработки десктопных приложений и игр. Специализируюсь на C++, Unreal, Unity.</p>
    
    <p>Увлекаюсь разработкой <s>велосипедов</s> собственных 2d движков и поглядываю за эволюцией AI. Ищу способы интеграции LLM в GameDev.</p>
    
    <p>Сейчас работаю над инди-проектами и делюсь тем, что узнаю на своём пути.</p>

    <!-- Резюме -->
    <h2>💼 Опыт работы</h2>
    <ul>
      <li><strong>Старший C++ разработчик</strong> — Cyberprotect (2025–настоящее время)</li>
      <li><strong>Старший программист игр на Unreal</strong> — Behaviour Interactive (2024–2025)</li>
      <li><strong>Старший C++ разработчик | Team Lead</strong> — Future Crew (2023–2025)</li>
      <li><strong>Старший C++ разработчик | Руководитель отдела разработки</strong> — Siemens (2010–2022)</li>
      <li><strong>Программист игрового процесса</strong> — Arkane Studios (2010–2011)</li>
    </ul>

    <h2>🛠️ Технологический стек</h2>
    <div style="display: flex; flex-wrap: wrap; gap: 0.5rem; margin-bottom: 1.5rem;">
      {["Unreal", "Unity", "C++", "C#", "SDL", "Qt", "llama.cpp"].map(tech => (
        <span style="
          background-color: #1a1a1a;
          padding: 0.25rem 0.75rem;
          border-radius: 9999px;
          font-size: 0.875rem;
          color: #c084fc;
        ">{tech}</span>
      ))}
    </div>

    <h2>📫 Где меня найти</h2>
    <ul>
      <li><strong>GitHub:</strong> <a href="https://github.com/oldscripter" style="color: #6366f1;">github.com/oldscripter</a></li>
      <li><strong>Email:</strong> <a href="mailto:oldscripter@gmail.com" style="color: #6366f1;">oldscripter@gmail.com</a></li>
      <li><strong>Telegram:</strong> <a href="https://t.me/Oldscripter" style="color: #6366f1;">@Oldscripter</a></li>
    </ul> 
  </div>
</BaseLayout>