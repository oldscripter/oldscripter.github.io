---
// src/layouts/BaseLayout.astro
import { GoogleAnalytics } from '@digi4care/astro-google-analytics';
import LanguageSwitcher from '../components/LanguageSwitcher.astro';

export interface Props {
  title: string;
  description?: string;
  image?: string;
  lang?: 'en' | 'ru';
}

const { title, description, image, lang } = Astro.props;
const siteTitle = "OldScripter — Blog";
const fullTitle = title ? `${title} | ${siteTitle}` : siteTitle;
const siteDescription = description || "Development insights, tutorials, and post-mortems from an indie developer";

// 🆕 Функция для получения локализованной ссылки
const getLocalizedPath = (path: string) => {
  if (lang === 'ru' && !path.startsWith('/ru')) {
    return `/ru${path}`;
  }
  return path;
};
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content={siteDescription} />
    <meta name="author" content="OldScripter" />
    <GoogleAnalytics id="G-0J0WNNQR8Q" />
    
    <!-- Open Graph / Social -->
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={siteDescription} />
    <meta property="og:type" content="website" />
    <meta property="og:image" content={image || "https://oldscripter.github.io/og-image.png"} />
    
    <!-- Twitter -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={fullTitle} />
    <meta name="twitter:description" content={siteDescription} />
    
    <title>{fullTitle}</title>
    
    <!-- Fonts -->
    <link href="https://fonts.googleapis.com/css2?family=Inter:opsz,wght@14..32,400;14..32,500;14..32,600;14..32,700&family=JetBrains+Mono:wght@400;500&display=swap" rel="stylesheet" />
    
    <!-- Syntax Highlighting (Shiki будет использован через Astro) -->
    
    <style is:global>
      * {
        margin: 0;
        padding: 0;
        box-sizing: border-box;
      }
      
      body {
        font-family: 'Source Code Pro', sans-serif;
        background-color: #101010;
        color: #bababaff;
        line-height: 1.6;
        font-weight: 200;
      }
      
      a {
        color: inherit;
        text-decoration: none;
        transition: color 0.2s ease;
      }
      
      a:hover {
        color: #6366f1;
      }

      a img {
        border-radius: 40px;
        border: 2px solid #404040ff;
        transition: border 0.5s ease;
      }

      a img:hover {
        border: 2px solid #6366f1
      }
      
      .container {
        max-width: 1200px;
        margin: 0 auto;
        padding: 0 1.5rem;
      }
      
      @media (max-width: 768px) {
        .container {
          padding: 0 1rem;
        }
      }
      
      /* Code blocks */
      pre {
        background-color: #0d1117;
        border-radius: 12px;
        padding: 1rem;
        overflow-x: auto;
        margin: 1.5rem 0;
        font-size: 0.875rem;
        border: 1px solid #30363d;  /* добавил рамку для чёткости */
      }

      details pre,
      details .highlight pre {
        background-color: #0d1117 !important;
        border-radius: 12px;
        padding: 1rem;
        overflow-x: auto;
        margin: 1.5rem 0;
        font-size: 0.875rem;
        border: 1px solid #30363d !important;
      }

      code {
        font-family: 'Source Code Pro', monospace;
        font-size: 0.875rem;
        font-variant-ligatures: none;  /* <-- ОТКЛЮЧАЕТ ЛИГАТУРЫ */
      }

      :not(pre) > code {
        background-color: #0d1117;
        padding: 0.2rem 0.4rem;
        border-radius: 6px;
        color: #c084fc;
        border: 1px solid #30363d;  /* тонкая рамка */
      }
      
      /* Headings */
      h1, h2, h3, h4, h5, h6 {
        font-weight: 200;
        line-height: 1.3;
        margin-top: 2rem;
        margin-bottom: 0.5rem;
        letter-spacing: -0.02em;
        font-family: 'JetBrains Mono', monospace;
      }
      
      h1 {
        font-size: 2.5rem;
        margin-top: 0;
      }
      
      h2 {
        font-size: 1.75rem;
        padding-bottom: 0.3rem;
        border-bottom: 2px solid #27272a;
      }
      
      h3 {
        font-size: 1.5rem;
        color: #8a8a8aff;
      }
      
      p {
        margin-bottom: 1.25rem;
      }
      
      ul, ol {
        margin: 1rem 0;
        padding-left: 1.5rem;
      }
      
      li {
        margin: 0.5rem 0;
      }
      
      blockquote {
        border-left: 4px solid #6366f1;
        padding-left: 1rem;
        margin: 1.5rem 0;
        color: #a1a1aa;
        font-style: italic;
      }
      
      hr {
        border: none;
        height: 1px;
        background: linear-gradient(90deg, transparent, #27272a, transparent);
        margin: 2rem 0;
      }
      
      img {
        max-width: 100%;
        border-radius: 12px;
        margin: 1.5rem 0;
      }

      details {
        color: #f6c527ff;
        font-family: 'JetBrains Mono', monospace;
      }

      /* Tables */
      table {
        width: 100%;
        border-collapse: collapse;
        margin: 1.5rem 0;
        font-size: 0.9rem;
        background-color: #111;
        border-radius: 8px;
        overflow: hidden;
        border: 1px solid #3f3f46;
        
      }

      thead {
        background-color: #1a1a1a;
      }

      th {
        text-align: left;
        padding: 0.75rem 1rem;
        font-weight: 600;
        border-bottom: 2px solid #3f3f46;
        border-right: 1px solid #3f3f46;
        min-width: 150px; /* минимальная ширина для заголовков */
        word-wrap: break-word; /* перенос длинных слов */
      }

      th:last-child {
        border-right: none;
      }

      td {
        padding: 0.75rem 1rem;
        border-bottom: 1px solid #3f3f46;
        border-right: 1px solid #3f3f46;
        min-width: 150px; /* минимальная ширина для ячеек */
        word-wrap: break-word; /* перенос длинных слов */
      }

      td:last-child {
        border-right: none;
      }

      tr:last-child td {
        border-bottom: none;
      }

      /* Чередование строк для читаемости */
      tbody tr:nth-child(even) {
        background-color: #161616;
      }

      tbody tr:hover {
        background-color: #1e1e1e;
      }

      /* Для адаптивности */
      .table-wrapper {
        overflow-x: auto;
        border-radius: 8px;
      }
      
      /* Стили для навигации и футера будут добавлены в компоненты */
    </style>
  </head>
  <body>
    <nav class="container" style="padding-top: 2rem; padding-bottom: 2rem;">
      <div style="display: flex; justify-content: space-between; align-items: center; gap: 2rem;">
        <a href="https://github.com/oldscripter" style="font-weight: 700; font-size: 1.25rem; letter-spacing: -0.02em;">
          <img src="/lds.png" alt="lds github link" align="left" style="max-width: 80px;">
        </a>
        <div style="display: flex; gap: 1.5rem;">
          <a href={getLocalizedPath('/')} style="font-size: 0.9rem;">{lang === 'ru' ? 'Блог' : 'Blog'}</a>
		      <a href={getLocalizedPath('/cpp')} style="font-size: 0.9rem;">C++</a>
		      <a href={getLocalizedPath('/projects')} style="font-size: 0.9rem;">{lang === 'ru' ? 'Проекты' : 'Projects'}</a>
          <a href={getLocalizedPath('/about')} style="font-size: 0.9rem;">{lang === 'ru' ? 'Обо мне' : 'About'}</a>
        </div>
        <div>
          <LanguageSwitcher />
        </div>
      </div>
    </nav>
    
    <main class="container">
      <slot />
    </main>
    
    <footer class="container" style="margin-top: 4rem; padding-bottom: 3rem; border-top: 1px solid #27272a; margin-top: 3rem;">
      <div style="display: flex; justify-content: space-between; align-items: center; gap: 1rem; flex-wrap: wrap; margin-top: 2rem;">
        <div style="font-size: 0.875rem; color: #71717a;">
          © {new Date().getFullYear()} OldScripter. All rights reserved.
        </div>
        <div style="display: flex; gap: 1.5rem;">
          <a href="https://github.com/oldscripter" target="_blank" style="font-size: 0.875rem; color: #71717a;">GitHub</a>
          <a href="mailto:oldscripter@gmail.com" style="font-size: 0.875rem; color: #71717a;">Contact</a>
        </div>
      </div>
    </footer>
  </body>
</html>